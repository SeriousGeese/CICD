# DnD: npm, 8-runner self-hosted fleet, reviews and merges Dependabot PRs itself.
#
# THIS FILE MIRRORS WHAT DnD WILL SET IN .cicd/config.env AT STAGE 5. Unlike the
# other two it is not yet a copy of a live file — DnD has not adopted the engine
# — so it is derived from DnD@main's workflows and its LIVE branch protection,
# re-verified rather than assumed.

# Verified against the API, not assumed: DnD uses CLASSIC branch protection, and
# its `main` requires TWO contexts — `e2e (Playwright)` and `gate`. The `gate`
# half is new; DnD grew an aggregate gate job plus ci-docs-shim.yml, and the
# earlier version of this file predates both.
#
# Its only ruleset ("Up to Date") is DISABLED, and required_contexts() reads the
# RULESETS endpoint — so it gets an empty answer and always falls back. That
# makes this value operative on every run here, not a safety net.
CICD_REQUIRED_CHECKS_FALLBACK=e2e (Playwright),gate

# NOT strict. The previous value was `true`, marked MANDATORY "until DnD has an
# aggregate gate job" — DnD now has one, so the condition that comment named has
# been met.
#
# It would be wrong even without that. DnD's close-beads.yml runs on
# `pull_request: [closed]` behind `if: merged == true`, so a PR closed WITHOUT
# merging leaves a skipped `close-beads` check on that head SHA — which strict
# mode would then wait on forever if the PR were reopened.
#
# Non-strict is safe because neither required context can skip: `gate` carries
# `if: ${{ always() }}`, and `e2e (Playwright)` is published by e2e-docs-shim.yml
# through the Checks API on the path-filtered PRs where e2e.yml does not run at
# all — a MISSING context, not a skipped one, and required_missing already
# blocks on that.
CICD_STRICT_SKIPPED=false

CICD_FEATURE_STACKED_PRS=true
CICD_FEATURE_MIGRATION_JOURNAL=true
CICD_FEATURE_APPROVE_HELD_RUNS=true
CICD_FEATURE_E2E_GATE=true
CICD_FEATURE_STAGE_DEPLOY=true
CICD_FEATURE_BEADS=true

# DnD reviews and merges Dependabot PRs with the bot itself, and has a
# Dependabot-scoped OPENROUTER_API_KEY so those runs get a key.
CICD_FEATURE_DEPENDABOT_SKIP=false
