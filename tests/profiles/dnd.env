# DnD: npm, 8-runner self-hosted fleet, no aggregate `gate` job, reviews and
# merges Dependabot PRs itself.
CICD_REQUIRED_CHECKS_FALLBACK=lint,type-check,build
# MANDATORY here: DnD has no `gate` job, so the precise skipped-check rule would
# depend on a required set that required_contexts() can fail open on.
CICD_STRICT_SKIPPED=true
CICD_FEATURE_STACKED_PRS=true
CICD_FEATURE_MIGRATION_JOURNAL=true
CICD_FEATURE_APPROVE_HELD_RUNS=true
CICD_FEATURE_E2E_GATE=true
CICD_FEATURE_STAGE_DEPLOY=true
CICD_FEATURE_BEADS=true
CICD_FEATURE_DEPENDABOT_SKIP=false
