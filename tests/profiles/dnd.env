# DnD: npm, 8-runner self-hosted fleet, no aggregate `gate` job yet, reviews and
# merges Dependabot PRs itself.
#
# The ONLY required status check on main today is `e2e (Playwright)` — verified
# against the live API, not assumed. DnD also uses CLASSIC branch protection
# rather than rulesets, and required_contexts() reads the RULESETS endpoint, so
# it gets an empty answer and always falls back. That makes this value operative
# on every run here, not a safety net.
CICD_REQUIRED_CHECKS_FALLBACK=e2e (Playwright)
# MANDATORY until DnD has an aggregate gate job: the precise skipped-check rule
# leans on a required set that, per the above, comes from the fallback alone.
CICD_STRICT_SKIPPED=true
CICD_FEATURE_STACKED_PRS=true
CICD_FEATURE_MIGRATION_JOURNAL=true
CICD_FEATURE_APPROVE_HELD_RUNS=true
CICD_FEATURE_E2E_GATE=true
CICD_FEATURE_STAGE_DEPLOY=true
CICD_FEATURE_BEADS=true
CICD_FEATURE_DEPENDABOT_SKIP=false
