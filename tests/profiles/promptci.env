# PromptCI: public, pnpm, single monolithic `ci` job as the required check,
# auto-merge.yml owns Dependabot PRs, npm publish rather than a deploy.
CICD_REQUIRED_CHECKS_FALLBACK=ci
# No aggregate `gate` job here either — the required check is the `ci` job itself.
CICD_STRICT_SKIPPED=true
CICD_FEATURE_STACKED_PRS=false
CICD_FEATURE_MIGRATION_JOURNAL=false
CICD_FEATURE_APPROVE_HELD_RUNS=false
CICD_FEATURE_E2E_GATE=false
CICD_FEATURE_STAGE_DEPLOY=false
CICD_FEATURE_BEADS=false
CICD_FEATURE_DEPENDABOT_SKIP=true
