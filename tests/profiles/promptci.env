# PromptCI: public, pnpm, a single monolithic `ci` job as the only required
# check, auto-merge.yml owns Dependabot PRs, npm publish rather than a deploy.
#
# THIS FILE MIRRORS THE REPO'S OWN .cicd/config.env AND MUST BE UPDATED WITH IT.
# Nothing enforces that from here — CICD cannot read a consumer repo — so a
# change there without a change here makes every profile-matrixed test in this
# suite validate a configuration nobody runs. Values below were taken from
# PromptCI@main after Stage 3 landed.
CICD_REQUIRED_CHECKS_FALLBACK=ci

# NOT strict, and the earlier `true` here was wrong in a way that would have
# broken production. The rule is not "strict when the repo has no aggregate gate
# job" — PromptCI has none, and strict mode there makes the reviewer wait out its
# full poll budget on EVERY pull request, because auto-merge.yml's job carries a
# job-level `if:` and so reports SKIPPED on every human-authored PR.
#
# Strict is safe only when NO check in the repo ever legitimately skips.
# Non-strict is safe when the REQUIRED context cannot itself skip — here `ci` is
# a job with no job-level `if:`, so it cannot.
CICD_STRICT_SKIPPED=false

# The three hold policies are left ON, matching the repo's config.env, which
# leaves them at the engine default. Each can only ever add a reason NOT to
# merge, so the repo gets the guard the day it first needs one. (MIGRATION_JOURNAL
# is inert here — it looks for a Drizzle journal and only DnD has one.)
CICD_FEATURE_STACKED_PRS=true
CICD_FEATURE_MIGRATION_JOURNAL=true
CICD_FEATURE_APPROVE_HELD_RUNS=true

# No e2e suite, no stage environment, and issues live in GitHub Issues.
CICD_FEATURE_E2E_GATE=false
CICD_FEATURE_STAGE_DEPLOY=false
CICD_FEATURE_BEADS=false

CICD_FEATURE_DEPENDABOT_SKIP=true
