# promptci-cloud: pnpm, ONE unlabelled self-hosted runner, aggregate `gate` job,
# auto-merge.yml owns Dependabot PRs, beads + stage deploy.
#
# THIS FILE MIRRORS THE REPO'S OWN .cicd/config.env AND MUST BE UPDATED WITH IT.
# Values below were taken from promptci-cloud@main after Stage 4 landed.
CICD_REQUIRED_CHECKS_FALLBACK=gate

# Not strict — but for a different reason than PromptCI reaches the same answer.
# Here the required context is the aggregate `gate`, which carries
# `if: ${{ always() }}` and therefore registers and reports on every run, and
# ci/e2e/audit gate their STEPS from the `changes` job's outputs rather than
# gating the jobs. auto-merge.yml still skips on draft PRs, so strict would wait
# on a check already in its final state.
CICD_STRICT_SKIPPED=false

CICD_FEATURE_STACKED_PRS=true
CICD_FEATURE_MIGRATION_JOURNAL=true
CICD_FEATURE_APPROVE_HELD_RUNS=true

# OFF despite this repo HAVING an e2e suite. The flag dispatches a standalone
# `e2e.yml`; here e2e is a JOB inside ci.yml, already covered by `gate`, so
# turning it on would dispatch a workflow that does not exist.
CICD_FEATURE_E2E_GATE=false

# Both dispatches exist here, and both are needed for the same reason: a
# GITHUB_TOKEN merge fires neither `pull_request: closed` nor `push`, so without
# them merged PRs never close their beads and stage never advances.
CICD_FEATURE_STAGE_DEPLOY=true
CICD_FEATURE_BEADS=true

CICD_FEATURE_DEPENDABOT_SKIP=true
